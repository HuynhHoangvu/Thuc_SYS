DATABASE_URL="mongodb+srv://<user>:<password>@thucsys.sidfzl2.mongodb.net/<dbname>?appName=thucsys"

# Progress-update emails (Resend). Leave RESEND_API_KEY empty in dev: mails are written to .mail-outbox/
RESEND_API_KEY=
MAIL_FROM="Catholic MTA <no-reply@mail.your-domain.com>"
# When set, every email goes to this address instead of the customer (test mode)
MAIL_TEST_RECIPIENT=
# Public URL of the app, used for the logo and the unsubscribe link in emails
APP_URL=http://localhost:3000
RESEND_WEBHOOK_SECRET=
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Optional public folder with the email images (copy of public/email/*.png), e.g. https://catholicmta.edu.vn/email-assets
EMAIL_ASSET_URL=
