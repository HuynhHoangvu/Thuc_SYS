generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum EnglishTest {
  IELTS
  TOEFL
  PTE
  Duolingo
  None
}

enum DestinationCountry {
  USA
  Canada
  NewZealand @map("New Zealand")
}

enum OcrStatus {
  not_applicable
  pending
  done
  failed
}

enum VirusScanStatus {
  pending
  clean
  infected
}

model Student {
  id String @id @default(cuid())

  // personal
  fullName       String
  dateOfBirth    DateTime?
  gender         Gender?
  nationality    String?
  passportNumber String?
  passportExpiry DateTime?
  email          String
  phone          String?
  address        String?

  // academic
  highestEducation String?
  schoolName       String?
  gpa              Float?
  graduationYear   Int?
  englishTest      EnglishTest?
  englishScore     String?

  // study abroad
  destinationCountry    DestinationCountry?
  intakeTerm            String?
  intakeYear            Int?
  preferredUniversities String[]
  preferredMajor        String?
  visaType              String?
  visaExpiry            DateTime?
  sevisId               String?
  i20Number             String?
  studyPermitNumber     String?
  dliNumber             String?
  nzQualificationCode   String?

  stage      String  @default("lead")
  stageOrder Int     @default(0)
  notes      String?

  todos             Todo[]
  documents         StudentDocument[]
  checklistProgress ChecklistProgress[]
  formSubmissions   FormSubmission[]
  workflowProgress  WorkflowProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([visaExpiry])
}

model Todo {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])
}

model ChecklistTemplate {
  id        String              @id @default(cuid())
  name      String
  country   DestinationCountry
  items     Json
  progress  ChecklistProgress[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ChecklistProgress {
  id         String            @id @default(cuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items      Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([studentId, templateId])
}

model FormTemplate {
  id          String              @id @default(cuid())
  name        String
  country     DestinationCountry?
  description String?
  fields      Json
  isActive    Boolean             @default(true)
  submissions FormSubmission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model FormSubmission {
  id          String       @id @default(cuid())
  templateId  String
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  values      Json
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([templateId, studentId])
}

model WorkflowTemplate {
  id          String              @id @default(cuid())
  name        String
  country     DestinationCountry?
  description String?
  steps       Json
  isActive    Boolean             @default(true)
  progress    WorkflowProgress[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model WorkflowProgress {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  steps      Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, templateId])
}

model StudentDocument {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category          String
  originalName      String
  storedName        String
  mimeType          String
  size              Int
  url               String
  version           Int             @default(1)
  previousVersionId String?
  ocrStatus         OcrStatus       @default(not_applicable)
  virusScanStatus   VirusScanStatus @default(pending)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([studentId, category])
}
